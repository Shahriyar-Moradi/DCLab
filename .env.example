# Local development uses native Postgres (Homebrew), not Docker.
# The same URL also works later with docker compose --profile docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/decisionai

# Ports. Browser JavaScript calls the same-origin /api/backend BFF. Only the
# server-side BFF and middleware use DCLAB_API_URL (or NEXT_PUBLIC_API_URL fallback).
API_PORT=8001
WEB_PORT=3001
DCLAB_API_URL=http://127.0.0.1:8001
DCLAB_WEB_URL=http://127.0.0.1:3001
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# CSV / open-ingest training. Production default is postgres (API persists a
# queued row; `make worker` / `dclab worker run` claims it). `make run` sets
# ML_JOB_DISPATCHER=thread so local uploads train in the API process.
# ML_JOB_DISPATCHER=postgres

# Auth. Development default JWT is rejected when DCLAB_ENV=production.
# Browser sessions are HttpOnly cookies (see docs/adr/0001-browser-session-bff.md
# and docs/adr/0002-session-csrf-csp-abuse.md). CSRF cookie dclab_csrf is not HttpOnly.
# DCLAB_ENV=development
# JWT_SECRET=change-me-in-any-deployed-environment
# SESSION_COOKIE_NAME=dclab_session
# SESSION_COOKIE_PATH=/
# SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_SECURE=false
# SESSION_IDLE_MINUTES=720
# SESSION_ABSOLUTE_MINUTES=10080
# SESSION_MAX_CONCURRENT=5
# SESSION_RETENTION_DAYS=30
# SESSION_CLEANUP_BATCH_SIZE=500
# SESSION_CLEANUP_MAX_BATCHES=20
# CSRF_COOKIE_NAME=dclab_csrf
# CSRF_HEADER_NAME=X-CSRF-Token
# LOGIN_THROTTLE_ATTEMPTS=5
# LOGIN_THROTTLE_WINDOW_MINUTES=15
# AUTH_BROWSER_SESSIONS_ENABLED=true
# AUTH_TOKEN_HASH_SECRET=
# AUTH_TOKEN_HASH_SECRET_PREVIOUS=
# AUTH_CSRF_SECRET=
# AUTH_EMAIL_DELIVERY_ENABLED=false
# There is no SMTP/IdP yet. Do not enable email delivery and do not return
# recovery tokens in JSON. AUTH_EMAIL_DELIVERY_ENABLED=true refuses to boot.
# AUTH_TRUST_FORWARDED=false
# Production also requires AUTH_TOKEN_HASH_SECRET and AUTH_CSRF_SECRET. Leave
# them empty in CI. Emergency kill switch: AUTH_BROWSER_SESSIONS_ENABLED=false
# rejects cookie sessions while POST /auth/tokens keeps working.
# Incident runbooks: docs/runbooks/session-cleanup.md,
# docs/runbooks/session-theft.md, docs/runbooks/auth-secret-rotation.md,
# docs/runbooks/session-mass-revocation.md.

# Optional advisory ML pipeline verifier. Reuses OPENAI_API_KEY by default.
PIPELINE_LLM_VERIFIER_ENABLED=false
PIPELINE_LLM_VERIFIER_MODEL=gpt-5.6-luna
PIPELINE_LLM_VERIFIER_DEEP_MODEL=gpt-5.6-terra
PIPELINE_LLM_TIMEOUT_SECONDS=30
