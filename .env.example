# Local development uses native Postgres (Homebrew), not Docker.
# The same URL also works later with docker compose --profile docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/decisionai

# Ports — frontend calls the API at DCLAB_API_URL / NEXT_PUBLIC_API_URL.
API_PORT=8001
WEB_PORT=3001
DCLAB_API_URL=http://127.0.0.1:8001
DCLAB_WEB_URL=http://127.0.0.1:3001
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
