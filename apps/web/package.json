{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "gen:api": "npm run gen:api:openapi && npm run gen:api:types",
    "gen:api:openapi": "cd ../.. && PYTHONPATH=apps/api ${DCLAB_PYTHON:-.venv/bin/python} -m scripts.export_web_openapi",
    "gen:api:types": "openapi-typescript lib/infrastructure/v1/openapi.json -o lib/infrastructure/v1/schema.d.ts",
    "gen:api:check": "npm run gen:api && git diff --exit-code -- lib/infrastructure/v1/",
    "test:components": "node --experimental-strip-types --test lib/infrastructure/*.test.ts lib/application/*.test.ts components/studio/*.test.ts next.config.test.mjs",
    "e2e:prepare": "cd ../.. && DATABASE_URL=${DCLAB_E2E_DATABASE_URL:-postgresql://localhost:55432/dclab_e2e_verify} .venv/bin/python scripts/seed_e2e_verification.py --recreate",
    "e2e": "npm run e2e:prepare && playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.3",
    "lucide-react": "^1.34.0",
    "next": "15.5.25",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.5.25",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
