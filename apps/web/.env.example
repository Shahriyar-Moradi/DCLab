# Browser talks only to this Next origin. The BFF at /api/backend proxies to FastAPI.
# Server-side BFF/middleware use DCLAB_API_URL (falls back to NEXT_PUBLIC_API_URL).
DCLAB_API_URL=http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:8001
# Must match API SESSION_COOKIE_NAME / CSRF_COOKIE_NAME.
# DCLAB_SESSION_COOKIE=dclab_session
# DCLAB_CSRF_COOKIE=dclab_csrf
# BFF process-protection bounds (not a product ingest cap).
# DCLAB_BFF_MAX_UPLOAD_BYTES=268435456
# DCLAB_BFF_MAX_DOWNLOAD_BYTES=536870912
